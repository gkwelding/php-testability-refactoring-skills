#!/usr/bin/env bash
# Stand-in for the claude CLI, for testing run.sh and judge.sh without API spend.
# Put this folder first on PATH. It applies the canned refactor in refactors/<Target>/ to the app in
# the current directory and prints a claude -p style JSON result.
#
# STUB_MODE=good       (default) a behaviour-preserving refactor plus one plain-TestCase unit test
# STUB_MODE=behaviour  the same, then refactors/<Target>.behaviour.sed changes one behaviour
# STUB_MODE=interface  the same, plus an interface for every class it touched (speculative)
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)

if [[ " $* " == *" --json-schema "* ]]; then
    cat > /dev/null
    v='{"winner":"A","reason":"stub verdict"}'
    echo "{\"total_cost_usd\":0,\"num_turns\":1,\"duration_ms\":1000,\"structured_output\":{\"minimal\":$v,\"behaviour\":$v,\"idiomatic\":$v,\"overall\":$v}}"
    exit 0
fi

target=$(grep -oE '(app|src)/[A-Za-z/]+\.php' <<< "$*" | head -1)
name=$(basename "$target" .php)
cp -r "$here/refactors/$name/." .

case ${STUB_MODE:-good} in
    behaviour) sed -i -f "$here/refactors/$name.behaviour.sed" "$target" ;;
    interface)
        for file in $(git ls-files -mo --exclude-standard -- app src); do
            class=$(grep -oE '^(final )?(readonly )?class [A-Za-z]+' "$file" | awk '{print $NF}') || continue
            ns=$(sed -nE 's/^namespace (.+);/\1/p' "$file")
            printf '<?php\n\nnamespace %s;\n\ninterface %sInterface\n{\n}\n' "$ns" "$class" > "$(dirname "$file")/${class}Interface.php"
            sed -i -E "/^(final )?(readonly )?class $class( |$)/{/ implements /s/$/, ${class}Interface/;/ implements /!s/$/ implements ${class}Interface/}" "$file"
        done ;;
esac

echo '{"type":"result","result":"Stub refactor applied.","total_cost_usd":0.01,"num_turns":3,"duration_ms":60000}'
